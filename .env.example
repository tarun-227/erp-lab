# Copy to .env and fill in. Both keys are optional: without them the AI tutor shows "offline"
# and the rest of the app works normally.
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model overrides
# TUTOR_TEXT_MODEL=
# TUTOR_VISION_MODEL=
# Optional: any OpenAI-compatible server instead of Groq/Gemini (e.g. a local Ollama at http://localhost:11434/v1)
# GROQ_BASE_URL=
# GEMINI_BASE_URL=
